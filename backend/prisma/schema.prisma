generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// -------------------------------------
// Core / Auth & Multi-Tenancy
// -------------------------------------

model Tenant {
  id           String        @id @default(uuid())
  name         String
  address      String?
  taxPin       String?       // e.g. KRA Pin
  logoUrl      String?
  phone        String?
  email        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  users        User[]
  customers    Customer[]
  jobCards     JobCard[]
  parts        PartCatalog[]
  appointments Appointment[]
  expenses     Expense[]
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  username       String?  @unique
  password       String   // Hashed
  name           String
  phone          String?
  specialization String?  // e.g., "Engine & Transmission", "Auto Electrical", "Body & Paint"
  commissionRate Float    @default(0) // e.g., 10 for 10% labour commission
  role           Role     @default(MECHANIC)
  isActive       Boolean  @default(true)

  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  MANAGER
  ADVISOR
  ACCOUNTS
  CASHIER
  STOREKEEPER
  INSPECTOR
  MECHANIC
  INVENTORY_MANAGER
}

// -------------------------------------
// Customers & Vehicles
// -------------------------------------

enum ClientCategory {
  PERSONAL
  GOVERNMENT
  SCHOOL
  ORGANIZATION
}

model Customer {
  id            String         @id @default(uuid())
  name          String
  phone         String?
  email         String?
  address       String?
  companyName   String?        // For Fleet / Corporate accounts
  category      ClientCategory @default(PERSONAL) // PERSONAL, GOVERNMENT, SCHOOL, ORGANIZATION
  taxPin        String?        // KRA PIN for ETR tax invoicing
  contactPerson String?        // Fleet Manager / Transport Officer / Bursar name
  contactPhone  String?        // Direct line for transport officer
  paymentTerms  String?        // "Cash/Mpesa", "30 Days Credit", "LPO/LSO"

  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])

  vehicles      Vehicle[]
  jobCards      JobCard[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId, category])
  @@index([name])
}

model Vehicle {
  id                 String         @id @default(uuid())
  registrationNo     String
  make               String?
  model              String?
  year               String?
  color              String?
  vinNumber          String?
  engineNumber       String?
  fuelType           String?        @default("Petrol") // Petrol, Diesel, Hybrid, Electric
  bodyType           String?        @default("sedan")  // sedan, suv, pickup, van, lorry, bus
  category           ClientCategory @default(PERSONAL)
  fleetUnitNumber    String?        // e.g. "BUS-04", "CAR-12", "UNIT-09"
  assignedDriver     String?        // Driver name
  driverPhone        String?        // Driver phone
  lastOdometer       Int?           @default(0)
  lastServiceDate    DateTime?
  avgDailyMileage    Int?           @default(30)
  nextServiceMileage Int?
  nextServiceDate    DateTime?

  customerId         String
  customer           Customer       @relation(fields: [customerId], references: [id])

  jobCards           JobCard[]

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([registrationNo])
  @@index([category])
}

// -------------------------------------
// Job Cards (Receiving Memo & Repair Order)
// -------------------------------------

model JobCard {
  id                 String        @id @default(uuid())
  jobNumber          String?       // e.g. JC01001
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id])

  customerId         String
  customer           Customer      @relation(fields: [customerId], references: [id])

  vehicleId          String
  vehicle            Vehicle       @relation(fields: [vehicleId], references: [id])

  odometer           Int?
  fuelType           String?       @default("Petrol") // Petrol, Diesel, Hybrid, Electric
  fuelLevel          String?       // e.g., "1/4", "Half", "Full"
  walkAroundData     Json?         // Checklists, 360Â° Damage Markers, Diagnostic & QC Data
  workRequested      String?
  technician         String?       // Assigned technician name
  bayNumber          String?       // e.g., "Bay 1 (Lift)", "Bay 2 (Pit)", "Electrical Bay"
  priority           String        @default("Medium") // Low, Medium, High
  dueDate            DateTime?
  status             JobStatus     @default(BOOKED)

  estimatedHours     Float?
  actualHours        Float?
  isWarranty         Boolean       @default(false)
  warrantyNotes      String?
  nextServiceMileage Int?
  nextServiceDate    DateTime?

  estimates          Estimate[]
  stockMovements     StockMovement[]
  auditLogs          JobCardAuditLog[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

enum JobStatus {
  BOOKED
  INSPECTION
  AWAITING_APPROVAL
  IN_PROGRESS
  WAITING
  QUALITY_CHECK
  READY
  COMPLETED
}

// -------------------------------------
// Immutable Audit Log for Job Cards
// -------------------------------------
model JobCardAuditLog {
  id         String   @id @default(uuid())
  jobCardId  String
  jobCard    JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  actorName  String
  actorRole  String?  @default("USER")
  action     String   // CREATED, STATUS_CHANGE, DETAILS_EDITED, INTAKE_PHOTO_UPLOADED, ADDITIONAL_FINDING_UPLOADED, PHOTO_DELETED, ODOMETER_CHANGED
  details    String
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([jobCardId])
  @@index([createdAt])
}

// -------------------------------------
// Spare Parts, Inventory & Stock Movements
// -------------------------------------

model PartCatalog {
  id             String          @id @default(uuid())
  partNumber     String
  description    String
  brand          String?
  compatibility  String?         // e.g., "Toyota Hilux, Prado, Corolla"
  costPrice      Float           @default(0) // Purchase cost for true profit calculation
  unitPrice      Float           // Selling price
  stockQuantity  Int             @default(10)
  reorderLevel   Int             @default(5)
  supplierName   String?
  supplierPhone  String?
  warrantyMonths Int             @default(6)
  location       String          @default("Main Store")
  quarantineQuantity Int         @default(0) // Returned/damaged stock awaiting review - not sellable

  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])

  stockMovements StockMovement[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model StockMovement {
  id        String   @id @default(uuid())
  partId    String
  part      PartCatalog @relation(fields: [partId], references: [id], onDelete: Cascade)

  jobCardId String?
  jobCard   JobCard? @relation(fields: [jobCardId], references: [id], onDelete: SetNull)

  type      String   @default("ISSUED") // RECEIVED, ISSUED, RETURNED, ADJUSTED
  quantity  Int      // positive for RECEIVED/RETURNED, negative or positive tracked by type
  notes     String?
  unitCost     Float?
  unitPrice    Float?
  supplierName String?
  reference    String?
  tenantId     String?

  createdAt DateTime @default(now())
}

// -------------------------------------
// Estimates, Invoicing & Payments
// -------------------------------------

model Estimate {
  id            String             @id @default(uuid())
  jobCardId     String
  jobCard       JobCard            @relation(fields: [jobCardId], references: [id])

  subtotal      Float
  discountRate  Float              @default(0) // e.g., 20 for 20%
  taxRate       Float              @default(16) // e.g., 16 for 16% VAT
  total         Float

  status        EstimateStatus     @default(DRAFT)

  lineItems     EstimateLineItem[]
  invoice       Invoice?

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

model EstimateLineItem {
  id          String   @id @default(uuid())
  estimateId  String
  estimate    Estimate @relation(fields: [estimateId], references: [id])

  itemType    String   @default("PART") // "PART" or "LABOUR"
  partId      String?  // Optional link to PartCatalog for automatic stock deduction
  description String
  quantity    Int
  unitPrice   Float
  total       Float
}

model Invoice {
  id             String        @id @default(uuid())
  estimateId     String        @unique
  estimate       Estimate      @relation(fields: [estimateId], references: [id])

  paymentStatus  PaymentStatus @default(UNPAID)
  paymentMode    String?       // "MPESA", "CARD", "CASH", "BANK_TRANSFER"
  amountPaid     Float         @default(0)
  balanceDue     Float         @default(0)
  mpesaReceiptNo String?       // e.g., "QKA8123XYZ"
  paymentHistory Json?         // Array of { date, amount, mode, reference, note }

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  PAY_LATER
}

// -------------------------------------
// Appointments & Workshop Expenses
// -------------------------------------

model Appointment {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  customerName   String
  phone          String?
  registrationNo String
  vehicleMake    String?
  serviceType    String   // e.g., "Periodic Maintenance", "Brake Inspection", "Diagnostic"
  scheduledAt    DateTime
  status         String   @default("SCHEDULED") // SCHEDULED, ARRIVED, COMPLETED, MISSED
  notes          String?
  reminderSent   Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Expense {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  category    String   // e.g., "Parts Purchase", "Rent & Utilities", "Salaries", "Consumables"
  description String
  amount      Float
  paymentMode String   @default("MPESA")
  reference   String?
  incurredAt  DateTime @default(now())

  createdAt   DateTime @default(now())
}


// =====================================================================
// Workshop Inventory: Requests, Issuance, Assets, Consumables, Audit
// Spare parts stay in PartCatalog/StockMovement. Everything below is
// tenant-scoped (tenantId on every row, checked by the API on each query).
// =====================================================================

enum InventoryCategory {
  SPARE_PART      // PartCatalog - resale / customer repairs
  TOOL_EQUIPMENT  // ToolAsset   - reusable company assets
  CONSUMABLE      // InventoryItem - internal supplies, never sold
}

// Catalogue of internal consumables and workshop supplies (gloves, rags, detergent...).
model InventoryItem {
  id                 String   @id @default(uuid())
  tenantId           String
  sku                String
  name               String
  unit               String   @default("pcs")
  description        String?
  quantityOnHand     Int      @default(0)
  quarantineQuantity Int      @default(0)
  reorderLevel       Int      @default(5)
  unitCost           Float    @default(0)
  location           String   @default("Main Store")
  supplierName       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId])
}

// One row per physical company-owned tool / machine.
model ToolAsset {
  id               String    @id @default(uuid())
  tenantId         String
  assetNumber      String
  name             String
  serialNumber     String?
  purchaseDate     DateTime?
  cost             Float     @default(0)
  condition        String    @default("GOOD")      // GOOD, FAIR, POOR, DAMAGED
  status           String    @default("AVAILABLE") // AVAILABLE, CHECKED_OUT, FIXED, UNDER_REVIEW, DAMAGED, LOST, WRITTEN_OFF
  isFixed          Boolean   @default(false)       // fixed equipment (lifts, alignment machines) - assigned, not checked out
  location         String    @default("Main Store")
  assignedTo       String?   // employee name (checked-out / permanently assigned)
  department       String?
  usedAt           String?   // where it is being used while checked out
  checkedOutAt     DateTime?
  expectedReturnAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, assetNumber])
  @@index([tenantId, status])
}

// Technician item request (approval is separate from physical issuance).
model ItemRequest {
  id             String   @id @default(uuid())
  tenantId       String
  reference      String   // e.g. REQ-000123
  technicianId   String?
  technicianName String
  jobCardId      String?
  vehicleId      String?
  department     String?  // workshop / department
  reason         String
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED, PARTIALLY_ISSUED, ISSUED, CANCELLED
  decidedBy      String?
  decidedAt      DateTime?
  decisionNotes  String?
  acknowledgedBy String?
  acknowledgedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines          ItemRequestLine[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([tenantId, technicianName])
}

model ItemRequestLine {
  id               String            @id @default(uuid())
  requestId        String
  request          ItemRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tenantId         String
  category         InventoryCategory
  partId           String?
  inventoryItemId  String?
  toolAssetId      String?
  description      String
  qtyRequested     Int
  qtyApproved      Int               @default(0)
  qtyIssued        Int               @default(0)
  qtyReturned      Int               @default(0) // restocked or quarantined returns, damaged and lost
  expectedReturnAt DateTime?

  @@index([requestId])
  @@index([tenantId])
}

// Returns waiting for inspection before becoming available stock.
model ItemReturn {
  id              String            @id @default(uuid())
  tenantId        String
  reference       String
  requestLineId   String?
  category        InventoryCategory
  partId          String?
  inventoryItemId String?
  toolAssetId     String?
  quantity        Int
  kind            String            @default("RETURN") // RETURN, DAMAGED, LOST
  condition       String?
  returnedBy      String
  receivedBy      String
  status          String            @default("PENDING_INSPECTION") // PENDING_INSPECTION, RESTOCKED, QUARANTINED, WRITTEN_OFF, LOST
  inspectedBy     String?
  inspectedAt     DateTime?
  notes           String?
  createdAt       DateTime          @default(now())

  @@index([tenantId, status])
}

// Immutable audit ledger. Rows are only ever inserted (DB trigger blocks UPDATE/DELETE).
model InventoryTransaction {
  id              String             @id @default(uuid())
  tenantId        String
  reference       String             // TXN-...
  type            String             // RECEIVE, REQUEST, APPROVE, REJECT, CANCEL, ISSUE, ACKNOWLEDGE, RETURN, INSPECT, DAMAGED, LOST, ADJUST, WRITE_OFF, ASSIGN, STOCKTAKE
  category        InventoryCategory?
  partId          String?
  inventoryItemId String?
  toolAssetId     String?
  itemName        String?
  requestId       String?
  requestLineId   String?
  jobCardId       String?
  vehicleId       String?
  department      String?
  location        String?
  quantity        Int                @default(0) // signed effect on available stock (+/-); 0 for workflow-only entries
  quantityDetail  Int                @default(0) // qty requested / approved / returned etc. for workflow entries
  unitCost        Float              @default(0)
  actorId         String?
  actorName       String
  actorRole       String
  recipientName   String?
  condition       String?
  reason          String?
  notes           String?
  createdAt       DateTime           @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, partId])
  @@index([tenantId, inventoryItemId])
  @@index([tenantId, toolAssetId])
  @@index([tenantId, jobCardId])
  @@index([tenantId, requestId])
}

// Physical count vs recorded balance; approval posts an ADJUST transaction.
model StockCount {
  id              String            @id @default(uuid())
  tenantId        String
  category        InventoryCategory
  partId          String?
  inventoryItemId String?
  itemName        String
  recordedQty     Int
  countedQty      Int
  variance        Int
  status          String            @default("PENDING") // PENDING, APPROVED, REJECTED
  countedBy       String
  approvedBy      String?
  approvedAt      DateTime?
  notes           String?
  createdAt       DateTime          @default(now())

  @@index([tenantId, status])
}

model StoreNotification {
  id         String    @id @default(uuid())
  tenantId   String
  targetRole String    // STOREKEEPER, TECHNICIAN...
  type       String
  message    String
  requestId  String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, targetRole, readAt])
}
